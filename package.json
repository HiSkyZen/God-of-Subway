{
  "name": "jigeumta",
  "version": "14.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun run src/bun-server.ts",
    "start": "bun run dist/server/bun-server.js",
    "build": "bun run scripts/clean-dist.ts && bun build --target=bun --production --outdir=dist/server ./src/bun-server.ts",
    "build:client": "bun build --target=browser --production ./src/client/sw.ts --outfile=dist/public/sw.js && bun run scripts/copy-pwa-assets.ts",
    "build:all": "bun run build && bun run build:client && bun run scripts/promote-static.ts",
    "verify:pwa": "bun run scripts/verify-pwa-assets.ts",
    "verify:aot": "bun run scripts/verify-aot.ts",
    "generate:vapid": "bun run scripts/generate-vapid.ts",
    "verify:vapid": "bun run scripts/verify-vapid.ts",
    "check:architecture": "bun run scripts/check-push-architecture.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:sw": "tsc -p tsconfig.sw.json",
    "test": "bun test",
    "check": "bun run typecheck && bun run typecheck:sw && bun run check:architecture && bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/web-push": "3.6.4",
    "bun-types": "1.3.14",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "3.6.7"
  }
}
