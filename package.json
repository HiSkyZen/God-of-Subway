{
  "name": "jigeumta",
  "version": "14.4.0",
  "private": true,
  "type": "module",
  "engines": { "bun": ">=1.3.14" },
  "scripts": {
    "dev": "bun run src/server.ts",
    "start": "bun run dist/server/server.js",
    "build:data": "bun run scripts/build-transit-db.ts",
    "build:data:fixture": "TRANSIT_DATA_MODE=fixture bun run scripts/build-transit-db.ts",
    "build": "bun run scripts/clean-dist.ts && bun build --target=bun --production --outdir=dist/server ./src/server.ts",
    "build:client": "bun build --target=browser --production ./src/client/sw.ts --outfile=dist/public/sw.js && bun run scripts/copy-pwa-assets.ts",
    "build:all": "bun run build && bun run build:client && bun run scripts/promote-static.ts",
    "verify:pwa": "bun run scripts/verify-pwa-assets.ts",
    "verify:aot": "bun run scripts/verify-aot.ts",
    "generate:vapid": "bun run scripts/generate-vapid.ts",
    "verify:vapid": "bun run scripts/verify-vapid.ts",
    "check:architecture": "bun run scripts/check-push-architecture.ts",
    "doctor": "bun run scripts/doctor.ts",
    "audit:transfers": "bun run scripts/audit-transfers.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:sw": "tsc -p tsconfig.sw.json",
    "test": "bun test",
    "check": "bun run doctor && bun run typecheck && bun run typecheck:sw && bun run check:architecture && bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/web-push": "3.6.4",
    "bun-types": "1.3.14",
    "typescript": "6.0.3"
  },
  "dependencies": { "react": "19.2.8", "react-dom": "19.2.8", "web-push": "3.6.7" }
}
